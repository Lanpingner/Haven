# Maintainer: Lanpingner <berromaa@gmail.com>
#
# The binary from the release workflow, unpacked. For a package built from
# source on your own machine, see haven-terminal.
#
# `packaging/aur/refresh.sh <tag>` fills in pkgver and the checksum from a
# published release; do not edit either by hand.

pkgname=haven-terminal-bin
pkgver=0.0.6
pkgrel=1
pkgdesc='A GPU terminal with the multiplexer already inside it (binary release)'
# Only what the release workflow builds. The source package covers the rest.
arch=('x86_64')
url='https://github.com/haven-terminal/Haven'
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'vulkan-icd-loader')
optdepends=('libx11: windows on X11'
            'libxcursor: cursors on X11'
            'libxrandr: multi-monitor on X11'
            'libxi: input on X11'
            'wayland: windows on Wayland'
            'noto-fonts-emoji: colour emoji')
provides=("haven=$pkgver" "haven-terminal=$pkgver")
conflicts=('haven' 'haven-terminal' 'haven-terminal-git')
# Nothing to strip — the release workflow stripped it — and splitting debug
# symbols out of a binary that has none produces an empty package.
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/haven-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('70e16d526065595cde9908488c86e19af809ea3629804b9b69542948815a76e2')

_dir="haven-$pkgver-x86_64-unknown-linux-gnu"

package() {
  cd "$_dir"
  install -Dm755 haven "$pkgdir/usr/bin/haven"
  install -Dm644 haven.desktop "$pkgdir/usr/share/applications/haven.desktop"
  install -Dm644 haven.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/haven.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
