/target
*.profraw
perf.data*
flamegraph.svg

# editor swap files; vim cycles the extension when one is taken, so .svh is
# as much a swap file as .swp
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
.s[a-v][a-z]
.sw[a-p]
*.swp
a.out

# mdbook output
/site/book

# makepkg's working directories and output, from building an AUR package in
# place. The PKGBUILD and .SRCINFO are the only files of a package worth
# keeping.
/packaging/aur/*/src/
/packaging/aur/*/pkg/
/packaging/aur/*/*.pkg.tar.*
/packaging/aur/*/*.tar.gz
